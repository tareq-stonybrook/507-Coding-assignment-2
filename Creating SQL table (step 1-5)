--STEP 1 : CREATING TABLE
CREATE TABLE USED_CAR_INVENTORY (
    VIN_ID VARCHAR2(20) PRIMARY KEY,
    MAKE VARCHAR2(20),
    MODEL VARCHAR2(20),
    MODEL_YEAR NUMBER(4),
    MILAGE NUMBER(10),
    FUEL_TYPE VARCHAR2(20),
    ENGINE_LITERS NUMBER(3,2),
    PRICE NUMBER (10,2),
    ACCIDENT_HISTORY VARCHAR2(3),
    DATE_ACQUIRED DATE,
    LAST_UPDATED TIMESTAMP

);

